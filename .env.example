# Copy this file to .env before running Docker Compose.
APP_PORT=8000
DJANGO_SECRET_KEY=change-me-for-local-development
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# API access is authenticated by default.
# Set true only for trusted local development if anonymous API access is needed.
API_ALLOW_ANONYMOUS=false

# CORS is restrictive by default.
DJANGO_CORS_ALLOW_ALL_ORIGINS=false
DJANGO_CORS_ALLOWED_ORIGINS=

# Production transport/browser security.
# Keep these false/zero for local HTTP development.
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false

# Enable only when a trusted reverse proxy sets X-Forwarded-Proto correctly.
DJANGO_TRUST_X_FORWARDED_PROTO=false
